NODE_ENV=production
PORT=3000

# 页面元信息（运行时注入到 index.html；留空则用构建时 frontend/site.config.js 的默认值）
# 改完重启容器即生效，不需要重新构建镜像。
# SITE_TITLE=Online Notepad - store your notes securely online
# SITE_DESCRIPTION=Web-based Notepad with automatic encryption. No registration needed. Maximum privacy. Zero tracking.
# SITE_KEYWORDS=cloud notepad, online notepad, encrypted notepad
# SITE_AUTHOR=Athlon1600

# 单篇笔记的体积上限（加密后的请求体字节数）。认 480kb / 2m / 1048576 这些写法。
# 不配 = 32m（硬上限，约 530 万汉字 / 1600 万英文字符）；写再多也按 32m 处理。
# 想收紧时显式配一个小值，例如 480kb（约 24 万汉字）。改完重启容器即生效，
# 前端会读同一个值并在输入时拦住超限内容，不需要重新构建镜像。
# NOTE_MAX_BYTES=32m

# 注意：如果前面还有一层 nginx，它的 client_max_body_size（默认 1m）会先一步拦掉，
# 必须一起调大；Caddy 的 request_body max_size 同理。
