NODE_ENV=production
PORT=3000

# 页面元信息（运行时注入到 index.html；留空则用构建时 frontend/site.config.js 的默认值）
# 改完重启容器即生效，不需要重新构建镜像。
# SITE_TITLE=Online Notepad - store your notes securely online
# SITE_DESCRIPTION=Web-based Notepad with automatic encryption. No registration needed. Maximum privacy. Zero tracking.
# SITE_KEYWORDS=cloud notepad, online notepad, encrypted notepad
# SITE_AUTHOR=Athlon1600

# 单篇笔记的体积上限（加密后的请求体字节数）。认 480kb / 2m / 1048576 这些写法。
# 不配 = 32m（默认，约 530 万汉字 / 1600 万英文字符）；写再多也按 32m 处理。
# 想收紧时显式配一个更小的值，例如 4m（约 65 万汉字），最大不超过硬上限 32m。
# 改完重启容器即生效，前端会读同一个值并在输入时拦住超限内容，不需要重新构建镜像。
# NOTE_MAX_BYTES=32m

# 注意：如果前面还有一层 nginx，它的 client_max_body_size（默认 1m）会先一步拦掉。
# nginx 的 m 是十进制（1m = 1000000 字节），1024 进制的 32m 要写成裸字节 33554432，
# 否则 nginx 会先一步判 413，比后端边界小 3.5MB。Caddy 的 request_body max_size 同理。

# 笔记信封结构校验的灰度开关。POST /api/notes 的请求体应当是一个加密信封 JSON
# （算法标签 + hex 的 iv 与密文）；服务端只查外壳形状，不解密，仍然零知识。
# 不配 = 影子模式：不合法的请求体只在日志里警告一条 [envelope]，照常保存；
# ENVELOPE_ENFORCE=1 后不合法的直接 400。回滚 = 置 0 或删掉这行，改完重启容器生效。
# ENVELOPE_ENFORCE=0

# 归档固定放在 backend/public/backups（文档根内，和上游一致），不做目录配置。
