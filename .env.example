# ───────────────────────────────────────────────────────────────────────
#  在线记事本 · 部署变量示范（.env.example）
#
#  用法：复制成 .env，放在 docker-compose.yml 旁边，改完重启即可：
#
#      cp .env.example .env
#      docker compose up -d
#
#  这里所有变量都是「运行时」生效的 —— 改完重启容器即可，不用重新构建镜像，
#  也不用重新拉镜像。以 # 开头的行是注释；等号后面留空表示用镜像里的默认值。
#
#  值一律用双引号包起来（空值写成 ""）：这样含空格、# 或其它特殊字符的值会被
#  原样读取，不会被当成行内注释截断、也不会被拆成多段。
# ───────────────────────────────────────────────────────────────────────

# ── 页面元信息（语言相关，支持 _ZH / _EN 后缀）──────────────────────────
# 中文界面用 _ZH 那套、英文界面用 _EN 那套：切换语言时 <title>、description/keywords
# 和页头名字都会跟着换（不会出现「英文页面顶着中文标题」）。
# 不带后缀的 SITE_TITLE=… 仍然有效，作为所有语言的通用兜底；
# 静态 HTML（爬虫看到的那份，不执行 JS）用 SITE_LANG 指定语言的一套，没设 SITE_LANG 就用 _EN。
SITE_TITLE=""
SITE_TITLE_ZH="在线记事本 - 安全地把笔记保存在网上"
SITE_TITLE_EN="Online Notepad - store your notes securely online"

SITE_DESCRIPTION=""
SITE_DESCRIPTION_ZH="安全地把笔记保存在网上，任何设备都能访问"
SITE_DESCRIPTION_EN="Store your notes securely online, from any device"

SITE_KEYWORDS=""
SITE_KEYWORDS_ZH="记事本,在线笔记,加密笔记"
SITE_KEYWORDS_EN="notepad,encrypted notes,online notes"

# 作者与语言无关；留空则不写 <meta name="author">
SITE_AUTHOR=""

# ── 页头左上角显示的名字（同样支持 _ZH / _EN）───────────────────────────
# 都不设时用上游的 notepad.mx
SITE_NAME=""
SITE_NAME_ZH="在线记事本"
SITE_NAME_EN="Online Notepad"

# ── 站点图标（favicon）─────────────────────────────────────────────────
# 留空 = 用镜像内置的 favicon.ico
# 想换成自己的图标：填完整 URL（https://example.com/my.ico），或填放到站点根目录的路径（/my.ico）
# 注意浏览器对 favicon 缓存很顽固，换完看不到可以强制刷新（Ctrl/Cmd+Shift+R）
SITE_ICON=""

# ── 界面语言 ───────────────────────────────────────────────────────────
# 运行时（容器里）：
#   zh / en    = 强制该语言，忽略访客浏览器语言
#   auto       = 跟随访客浏览器语言（访客在页头手动切过的记在 localStorage 里，优先级更高）
#   不设置      = 按已设置的语言变量推断：设了任何 _ZH 变量就当中文（否则看 _EN，都没有则维持原样）
#
# 构建镜像时（决定静态 HTML，也就是爬虫和首屏看到的那份）：
#   zh 或 en   = 就渲染那一套
#   zh,en      = 中英各渲染一份，运行时按访客的 Accept-Language 挑对应那份（推荐，两边都不闪）
#   auto / 不设 = 用英文
SITE_LANG="zh"

# ── 口令哈希的 salt（兼容性关键项）──────────────────────────────────────
# 这就是 upstream 说的 APP_KEY（代码里 frontend/src/config.js）。
#
#   · 保持默认 notepad.mx  → 与公共 notepad.mx 的笔记「互通」：同一个口令在两边指向同一批笔记
#   · 换成自己的值         → 自成一个命名空间，与其它实例互不通用
#
# ⚠️ 之后改这个值，用旧 salt 创建的笔记在界面上就找不回来了（存储 key 会跟着变）——改之前先备份。
SITE_SALT="notepad.mx"

# ── 容器内每日归档（backend/bin/archive.sh）─────────────────────────────
# 时区：下面 cron 的小时数按这个时区解释（容器默认 UTC，不设会差 8 小时）
TZ="Asia/Shanghai"
# 归档时间：标准 5 段 cron 表达式；填 off 可关闭。
# 默认每天 03:30（按上面的 TZ 算）
ARCHIVE_CRON="30 3 * * *"

# ── 归档下载开关 ───────────────────────────────────────────────────────
# on  = 默认（不设也是这个）：/backups/ 页面能点开下载归档，和上游 notepad.mx 一样公开
# off = 只列出文件名 / 大小 / 时间，不给下载入口；直接拼 /backups/<文件名> 也会返回 403
BACKUPS_DOWNLOAD="on"

# ── 归档保留天数 ────────────────────────────────────────────────────────
# 不设（默认）= 保留全部，绝不自动删除；
# 正整数 N    = 只保留最近 N 天生成的 archive_YYYYMMDD.tar.gz，更早的自动删掉。
# 例：7 保留一周，30 保留一个月。archive.tar.gz（最新一份）永远保留。
# 嫌归档文件越积越多就设一个 —— 删除发生在归档任务里（每天一次）。
ARCHIVE_KEEP_DAYS=""

# ── 端口 ───────────────────────────────────────────────────────────────
# 端口在 docker-compose.yml 的 ports 里写死为 3000:3000；
# 想换端口就直接改那一行，例如改成 "8080:3000"（左边是宿主机端口）。

# ── 本地构建 / 推送镜像时才需要 ─────────────────────────────────────────
# CI（GitHub Actions）里用的是仓库 Secrets，不需要写在这里。
# 只有你在本机执行 docker compose build + push 时才用得上：
#   docker login -u "$DOCKERHUB_USERNAME" -p "$DOCKERHUB_TOKEN"
# DOCKERHUB_USERNAME=""
# DOCKERHUB_TOKEN=""
# ALIYUN_DOCKER_USERNAME=""
# ALIYUN_DOCKER_TOKEN=""
